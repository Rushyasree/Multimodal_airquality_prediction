# VayuDrishti — Air Quality Intelligence Environment Configuration
# Copy this file to .env and configure your keys.
# .env is ignored by version control and will never be committed.

# -------------------------------------------------------------
# 1. OpenAQ API v3 Configuration
# -------------------------------------------------------------
# Obtain your free API key at: https://explore.openaq.org/register
OPENAQ_API_KEY=your_openaq_api_key_here

# Provider selection: "openaq" (default), "cpcb_datagov", or "auto"
AIR_QUALITY_PROVIDER=openaq

# HTTP request timeout in seconds
AIR_QUALITY_TIMEOUT_SECONDS=5.0

# In-memory response cache TTL in seconds (default: 300s / 5 minutes)
AIR_QUALITY_CACHE_TTL_SECONDS=300

# Freshness thresholds in hours
# Observations <= 3 hours old are labeled "LIVE DATA"
AIR_QUALITY_FRESHNESS_HOURS_LIVE=3.0
# Observations <= 24 hours old are labeled "RECENT OBSERVATION"
AIR_QUALITY_FRESHNESS_HOURS_RECENT=24.0

# -------------------------------------------------------------
# 2. UI Configuration
# -------------------------------------------------------------
# Auto-refresh interval in seconds (0 to disable)
DASHBOARD_AUTO_REFRESH_SECONDS=300
